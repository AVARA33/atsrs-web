{
  "name": "@atsrs/android",
  "private": true,
  "version": "0.1.0",
  "description": "Official ATSRS Android application shell",
  "scripts": {
    "web:sync": "node scripts/sync-web-assets.mjs",
    "android:sync": "npm run web:sync && cap sync android",
    "android:open": "cap open android",
    "android:debug": "npm run android:sync && node scripts/gradle.mjs assembleDebug",
    "android:test": "npm run android:sync && node scripts/gradle.mjs testDebugUnitTest lintDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.0.1",
    "@capacitor/browser": "8.0.1",
    "@capacitor/core": "8.5.0",
    "@capacitor/network": "8.0.1",
    "@capacitor/splash-screen": "8.0.1",
    "@capacitor/status-bar": "8.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0"
  }
}
