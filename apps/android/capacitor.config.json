{
  "appId": "com.atsrs.app",
  "appName": "ATSRS",
  "webDir": "www",
  "backgroundColor": "#030706",
  "server": {
    "hostname": "localhost",
    "androidScheme": "https",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#030706"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "disable",
      "style": "LIGHT"
    },
    "SplashScreen": {
      "launchShowDuration": 1000,
      "launchAutoHide": true,
      "backgroundColor": "#030706",
      "showSpinner": false,
      "androidScaleType": "CENTER_INSIDE",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "LIGHT",
      "backgroundColor": "#030706"
    }
  }
}
